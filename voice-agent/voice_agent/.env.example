# ==============================================================================
# Voice Agent & Multi-Agent Reception Backend - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your local settings:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env or real API keys to version control!
# ==============================================================================

# Application Environment (development | staging | production | test)
APP_ENV=development
LOG_LEVEL=INFO

# Standalone Daemon Server Settings
VOICE_AGENT_HOST=0.0.0.0
VOICE_AGENT_PORT=8765

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# Supported providers: "gemini" (recommended for Live voice), "openai", or "demo" (offline test)
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=20
# Gemini TTS voice IDs (Google prebuilt voices by default; override with an available voice ID).
GEMINI_TTS_ARABIC_VOICE=Kore
GEMINI_TTS_ENGLISH_VOICE=Kore

# Bidirectional Live Voice Model (Gemini Live WebSocket)
LIVE_VOICE_MODEL=gemini-3.8-live

# ------------------------------------------------------------------------------
# Backend Platform / CareOS Orchestrator Connection
# - "mock": Development/test-only, non-persistent behavior (no remote backend)
# - "staging": Connects to CareOS FastAPI backend (http://localhost:8000/api/v1)
# - "production": Connects to the authenticated production CareOS backend
# HTTP modes also require ORCHESTRATOR_TOKEN. Never use mock mode for real bookings.
# ------------------------------------------------------------------------------
ORCHESTRATOR_MODE=mock
ORCHESTRATOR_URL=http://localhost:8000/api/v1
ORCHESTRATOR_TIMEOUT_SECONDS=10.0
ORCHESTRATOR_TOKEN=

# CareOS API URL
CAREOS_API_URL=http://localhost:8000/api/v1