APP_ENV=development
APP_NAME=careos-api
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://careos:change-me@localhost:5432/careos
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SAML_METADATA_URL=
AUDIT_RETENTION_DAYS=2555
BACKUP_BUCKET=
BACKUP_REGION=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# External providers are configured by the deployment, never the frontend.
AI_API_KEY=
AI_BASE_URL=
OCR_PROVIDER=sandbox
NOTIFICATION_PROVIDER=sandbox
CORS_ORIGINS=http://localhost:5173
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
JWT_AUDIENCE=careos-api
