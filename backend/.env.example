# =============================================================================
# CareOS Backend — Environment Configuration Template (backend/.env.example)
# =============================================================================
# Copy this file to `backend/.env` before starting the backend:
#   Copy-Item backend\.env.example backend\.env
#
# NEVER commit real API keys, production secrets, or patient data to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application & Server Settings
# -----------------------------------------------------------------------------
APP_NAME=careos-api
APP_ENV=development
DEPLOYMENT_NAME=careos-local
API_PREFIX=/api/v1
APP_URL=http://localhost:5173
LOG_LEVEL=INFO
METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# 2. Database
# -----------------------------------------------------------------------------
# Relative SQLite URLs resolve automatically inside the backend/ directory:
DATABASE_URL=sqlite+aiosqlite:///./careos-local.db
# PostgreSQL + pgvector example:
# DATABASE_URL=postgresql+asyncpg://careos:careos@localhost:5432/careos

# -----------------------------------------------------------------------------
# 3. Security, Authentication & CORS
# -----------------------------------------------------------------------------
SECRET_KEY=development-only-change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
AUTH_RATE_LIMIT_REQUESTS=60
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
SSO_ALLOWED_REDIRECT_HOSTS=localhost,127.0.0.1,[::1],careos.example.com

# -----------------------------------------------------------------------------
# 4. Document Storage (Uploads)
# -----------------------------------------------------------------------------
STORAGE_BACKEND=filesystem
STORAGE_PREFIX=careos
STORAGE_LOCAL_ROOT=storage/uploads
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_CONTENT_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,audio/webm,audio/wav,audio/mpeg,image/png,image/jpeg,image/webp
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# 5. OCR, Clinical RAG & Vector Embeddings
# -----------------------------------------------------------------------------
OCR_DEFAULT_ENGINE=printed
OCR_LANGUAGE=ar
HANDWRITING_OCR_MODEL=sherif1313/Arabic-handwritten-OCR-4bit-Qwen2.5-VL-3B-v3
HANDWRITING_OCR_DEVICE=auto

RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Set to true on a new machine so the ~90 MB embedding model downloads on first use
RAG_ALLOW_MODEL_DOWNLOAD=true
VECTOR_TOP_K=8
RAG_TOP_K=8
RAG_RELEVANCE_THRESHOLD=0.55
LEGACY_RAG_DB_PATH=

# -----------------------------------------------------------------------------
# 6. External AI / LLM & Speech Providers (Optional)
# -----------------------------------------------------------------------------
AI_PROVIDER=unconfigured
AI_API_URL=
AI_API_KEY=
AI_MODEL=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-2.5-flash
OPENAI_TIMEOUT_SECONDS=45.0

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash

SPEECH_TO_TEXT_PROVIDER=unconfigured
SPEECH_TO_TEXT_API_URL=
SPEECH_TO_TEXT_API_KEY=
SPEECH_TO_TEXT_MODEL=gpt-4o-mini-transcribe
SPEECH_TO_TEXT_LANGUAGE=ar-EG
SPEECH_TO_TEXT_DIARIZATION=true

TEXT_TO_SPEECH_PROVIDER=gtts
TEXT_TO_SPEECH_API_URL=
TEXT_TO_SPEECH_API_KEY=
TEXT_TO_SPEECH_MODEL_ID=
TEXT_TO_SPEECH_DEFAULT_SPEAKER=Mohamed

# -----------------------------------------------------------------------------
# 7. Optional Hospital SSO (OIDC) & SMTP Email
# -----------------------------------------------------------------------------
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=
OIDC_CLIENT_SECRET=
SAML_METADATA_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
