{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run CareOS Backend",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "DATABASE_URL": "sqlite+aiosqlite:///./careos-local.db"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run CareOS Frontend",
      "type": "shell",
      "command": "npm run dev -- --host 127.0.0.1 --port 5173",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}