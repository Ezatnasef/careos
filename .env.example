# =============================================================================
# CareOS Healthcare AI — Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to `.env` (in the project root) or `backend/.env` before
# running the application:
#   Copy-Item .env.example .env
#   Copy-Item backend\.env.example backend\.env
#
# NEVER commit real API keys, production secrets, or patient data to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application & Server Settings
# -----------------------------------------------------------------------------
APP_NAME=careos-api
# Options: development | staging | production
APP_ENV=development
DEPLOYMENT_NAME=careos-local
API_PREFIX=/api/v1
APP_URL=http://localhost:5173
LOG_LEVEL=INFO
METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# 2. Frontend (Vite) Settings
# -----------------------------------------------------------------------------
# Frontend dev server port (used by vite.config.ts)
VITE_PORT=5173
# Leave empty in local development to use Vite's built-in /api/v1 proxy to 127.0.0.1:8000,
# or set to http://127.0.0.1:8000/api/v1 if calling the backend directly.
VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# 3. Database
# -----------------------------------------------------------------------------
# Local development default (SQLite file resolved relative to backend/):
DATABASE_URL=sqlite+aiosqlite:///./careos.db
# Production / Docker PostgreSQL + pgvector example:
# DATABASE_URL=postgresql+asyncpg://careos:careos@localhost:5432/careos

# -----------------------------------------------------------------------------
# 4. Security, Authentication & CORS
# -----------------------------------------------------------------------------
# REQUIRED in production (must be >= 32 characters and not the dev placeholder)
SECRET_KEY=development-only-change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
AUTH_RATE_LIMIT_REQUESTS=60
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Comma-separated list of allowed frontend origins and HTTP Host headers
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
SSO_ALLOWED_REDIRECT_HOSTS=localhost,127.0.0.1,[::1],careos.example.com

# -----------------------------------------------------------------------------
# 5. Document Storage (Uploads)
# -----------------------------------------------------------------------------
# Options: filesystem | s3
STORAGE_BACKEND=filesystem
STORAGE_PREFIX=careos
# Relative paths resolve inside backend/ (default when empty: backend/storage/uploads)
STORAGE_LOCAL_ROOT=storage/uploads
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_CONTENT_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,audio/webm,audio/wav,audio/mpeg,image/png,image/jpeg,image/webp

# Optional S3 settings (only required when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# 6. OCR, Clinical RAG & Vector Embeddings
# -----------------------------------------------------------------------------
# Default OCR engine mode: printed | handwriting | auto
OCR_DEFAULT_ENGINE=printed
OCR_LANGUAGE=ar
HANDWRITING_OCR_MODEL=sherif1313/Arabic-handwritten-OCR-4bit-Qwen2.5-VL-3B-v3
HANDWRITING_OCR_DEVICE=auto

# Multilingual Arabic/English SentenceTransformer model (384-dim E5 embeddings)
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Set to true on a new machine so the model is downloaded on first use (~470 MB)
RAG_ALLOW_MODEL_DOWNLOAD=true
VECTOR_TOP_K=8
RAG_TOP_K=8
RAG_RELEVANCE_THRESHOLD=0.55

# Optional path to a read-only clinical guideline SQLite DB (careos_rag.db)
LEGACY_RAG_DB_PATH=

# -----------------------------------------------------------------------------
# 7. External AI / LLM & Speech Providers (Optional)
# -----------------------------------------------------------------------------
# Note: Clinical RAG works out-of-the-box using deterministic Extractive Evidence Synthesis
# without any external LLM API key. To enable external LLM generation, configure below:
AI_PROVIDER=unconfigured
AI_API_URL=
AI_API_KEY=
AI_MODEL=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-3.8-flash
OPENAI_TIMEOUT_SECONDS=45.0

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.8-flash

SPEECH_TO_TEXT_PROVIDER=unconfigured
SPEECH_TO_TEXT_API_URL=
SPEECH_TO_TEXT_API_KEY=
SPEECH_TO_TEXT_MODEL=gpt-4o-mini-transcribe
SPEECH_TO_TEXT_LANGUAGE=ar-EG
SPEECH_TO_TEXT_DIARIZATION=true

TEXT_TO_SPEECH_PROVIDER=voicetut
TEXT_TO_SPEECH_API_URL=
TEXT_TO_SPEECH_API_KEY=
TEXT_TO_SPEECH_MODEL_ID=
TEXT_TO_SPEECH_DEFAULT_SPEAKER=Mohamed

# -----------------------------------------------------------------------------
# 8. Optional Hospital SSO (OIDC) & SMTP Email
# -----------------------------------------------------------------------------
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=
OIDC_CLIENT_SECRET=
SAML_METADATA_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
